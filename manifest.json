{
  "name": "support [ecmarkets]",
  "description": "Support tự động login, send data. ",
  "version": "1.0",
  "manifest_version": 3,
  
  "action": {                                 
	"default_icon": "images/support.png",
	"default_popup": "support-popup.html"
  },
  
  "web_accessible_resources": [  
		{
		  "resources": [ 
				"*.html",
				"*.css",
				"*.png",
				"*.gif",
				"*.svg"
			],
		  "matches": [ "<all_urls>" ]
		}
	],
	
  "permissions": [
		"tabs",
		"storage", 
		"bookmarks",
		"scripting",
		"activeTab",
		"declarativeContent",
		"unlimitedStorage" 
    ],
    
	"host_permissions": [
		"http://theodoi.free.nf/*",
		"https://theodoi.free.nf/*",
		"http://localhost/*", 
		"https://phuongdv-theodoi-default-rtdb.firebaseio.com/*", 
		"https://dvphuong-55233-default-rtdb.asia-southeast1.firebasedatabase.app/*",  
		"https://crm.ecmarkets.com/*"
	],
	
  "chrome_url_overrides" : {
	  "newtab": "contentlog-newtab.html"
	},
	
  "background": { 
	  "service_worker": "service_worker.js",
	  "type": "module"
    }, 

  "content_scripts": [
	  {
		  "matches": [ 
				"https://in.tradingview.com/*",
				"https://vi.tradingview.com/*",
				"https://en.tradingview.com/*",
				"https://tradingview.com/*",
				"https://www.tradingview.com/*",

				"https://thuviensach.vn/*",
				"https://learn.eltngl.com/*",
				"https://crm.ecmarkets.com/*",
				"https://ecmarkets.com/*",
				"https://www.ecmarkets.com/*"
			],
		  "js": [
			  "scripts/lib/jquery-1.11.1.min.js",  
			  "scripts/tradingview.js",
			  "scripts/quanlyaccount_cm_markets.js"
			],
		  "css":["styles/import-file-vao-trang-web-matches.css"],
		  "type": "module"
	  }
	]
}